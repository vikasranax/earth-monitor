# ══════════════════════════════════════════════════════════════
# JAGAT-MANTHAN · ENV CONTRACT · copy to .env.local and arm per-module
# Every value is validated at boot by src/lib/env.ts (Zod).
# ══════════════════════════════════════════════════════════════

# ── CORE ───────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# generate with: openssl rand -hex 32   (required from M03 for cron ingestion)
INGEST_HMAC_KEY=

# ── CACHE & RATE-LIMIT (M03) · https://upstash.com (free tier) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── FIREBASE (M03/M11) · console.firebase.google.com ──────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# base64 of the service-account JSON — SERVER ONLY, never NEXT_PUBLIC
FIREBASE_SERVICE_ACCOUNT=

# ── NEWS (M06) · https://open-platform.theguardian.com (free key)
GUARDIAN_API_KEY=

# ── MARKETS (M07) ──────────────────────────────────────────────
TWELVEDATA_API_KEY=          # https://twelvedata.com (free: 800/day)
FRED_API_KEY=                # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=                 # https://www.eia.gov/opendata (free)

# ── SHIPS (M08) · https://aisstream.io (free WS key, browser-direct)
NEXT_PUBLIC_AISSTREAM_API_KEY=

# ── AIRSPACE (M09) · https://opensky-network.org (optional account)
OPENSKY_USER=
OPENSKY_PASS=

# ── ATMOSPHERE & OUTAGES (M10) ─────────────────────────────────
OPENAQ_KEY=                  # https://openaq.org
CLOUDFLARE_RADAR_TOKEN=      # https://dash.cloudflare.com → API Tokens

# ── AI GATEWAY (M12) · failover chain, arm at least one ───────
GEMINI_API_KEY=              # https://aistudio.google.com
GROQ_API_KEY=                # https://console.groq.com
OPENROUTER_API_KEY=          # https://openrouter.ai (optional)

# ── ALERTING (M11) · https://resend.com (free: 3,000/mo) ───────
RESEND_API_KEY=

# ── MAPS (M05, optional) ───────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── UNREST DATA (optional) · https://acleddata.com — free registration
ACLED_EMAIL=
ACLED_PASSWORD=